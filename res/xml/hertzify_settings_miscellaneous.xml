<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res/com.android.settings"
    android:title="@string/hertzify_miscellaneous_title">

    <!-- Play Integrity Fix -->
    <Preference
        android:key="play_integrity_fix"
        android:title="@string/spoof_pif_title"
        android:summary="@string/spoof_pif_summary"
        android:fragment="com.hertzify.settings.fragments.miscellaneous.PlayIntegrityFix" />

    <!-- TrickyStore -->
    <Preference
        android:key="tricky_store"
        android:title="@string/spoof_ts_title"
        android:summary="@string/spoof_ts_summary"
        android:fragment="com.hertzify.settings.fragments.miscellaneous.TrickyStore" />

    <!-- App Spoofing -->
    <Preference
        android:key="app_spoofing"
        android:title="@string/spoof_ap_title"
        android:summary="@string/spoof_ap_summary"
        android:fragment="com.hertzify.settings.fragments.miscellaneous.AppSpoofing" />

    <!-- Hide developer status in about phone -->
    <Preference
        android:key="hide_developer_status_settings"
        android:title="@string/hide_developer_status_title"
        android:summary="@string/hide_developer_status_summary"
        android:fragment="com.hertzify.settings.fragments.miscellaneous.HideDeveloperStatusSettings"
        settings:controller="com.hertzify.settings.fragments.miscellaneous.HideDeveloperStatusPreferenceController" />

    <!-- Hide app list -->
    <Preference
        android:key="hide_applist_setting"
        android:title="@string/hide_applist_title"
        android:summary="@string/hide_applist_summary"
        android:fragment="com.hertzify.settings.fragments.miscellaneous.HideAppListSettings" />

    <!-- Allow application downgrade -->
    <com.hertzify.settings.preferences.GlobalSettingSwitchPreference
        android:key="pm_downgrade_allowed"
        android:title="@string/miscellaneous_app_downgrade_title"
        android:summary="@string/miscellaneous_app_downgrade_summary"
        android:defaultValue="false" />

    <!-- Ignore window secure flag -->
    <com.hertzify.settings.preferences.GlobalSettingSwitchPreference
        android:key="window_ignore_secure"
        android:title="@string/ignore_window_secure_title"
        android:summary="@string/ignore_window_secure_summary"
        android:defaultValue="false"/>
</PreferenceScreen>
