<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res/com.android.settings"
    android:title="@string/hertzify_miscellaneous_title">

    <!-- Play Integrity Fix -->
    <Preference
        android:key="play_integrity_fix"
        android:title="@string/spoof_pif_title"
        android:summary="@string/spoof_pif_summary"
        android:fragment="com.hertzify.settings.fragments.miscellaneous.PlayIntegrityFix" />
        
    <!-- Allow application downgrade -->
    <com.hertzify.settings.preferences.GlobalSettingSwitchPreference
        android:key="pm_downgrade_allowed"
        android:title="@string/miscellaneous_app_downgrade_title"
        android:summary="@string/miscellaneous_app_downgrade_summary"
        android:defaultValue="false" />

    <!-- Ignore window secure flag -->
    <com.hertzify.settings.preferences.GlobalSettingSwitchPreference
        android:key="window_ignore_secure"
        android:title="@string/ignore_window_secure_title"
        android:summary="@string/ignore_window_secure_summary"
        android:defaultValue="false"/>

    <!-- Smart Pixels -->
    <Preference
        android:key="smart_pixels"
        android:title="@string/smart_pixels_title" 
        android:summary="@string/smart_pixels_summary" 
        android:fragment="com.hertzify.settings.fragments.miscellaneous.SmartPixels" />

    <com.hertzify.settings.preferences.SystemSettingSwitchPreference
        android:key="screenshot_clipboard_only"
        android:title="@string/screenshot_clipboard_only_title"
        android:summary="@string/screenshot_clipboard_only_summary"
        android:defaultValue="false" />

    <com.hertzify.settings.preferences.SystemSettingSwitchPreference
        android:key="hide_status_bar_in_screenshot"
        android:title="@string/hide_status_bar_in_screenshot_title"
        android:summary="@string/hide_status_bar_in_screenshot_summary"
        android:defaultValue="false" />
</PreferenceScreen>
